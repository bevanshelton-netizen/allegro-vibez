FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends icecast2 gettext-base ca-certificates && rm -rf /var/lib/apt/lists/*
COPY icecast.xml /template/icecast.xml
CMD ["sh","-lc","envsubst < /template/icecast.xml > /etc/icecast2/icecast.xml && exec icecast2 -c /etc/icecast2/icecast.xml"]
