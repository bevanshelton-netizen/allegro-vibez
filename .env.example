# Preferred backend: IZAKHONO Core.
# Zero-Cost Host Mode can run on an existing computer with no paid VPS:
#   VITE_IZAKHONO_CORE_URL=http://127.0.0.1:8787
# For a later public/dedicated host, replace the URL with its HTTPS Core address.
VITE_IZAKHONO_CORE_URL=http://127.0.0.1:8787
VITE_IZAKHONO_PROJECT=allegro_vibez
VITE_IZAKHONO_PUBLIC_KEY=ik_pub_REPLACE_ME

# Current production fallback during the migration window.
# Leave these available until the IZAKHONO-hosted signup, storage, discovery,
# wallet, moderation and PayFast launch gates have passed.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
