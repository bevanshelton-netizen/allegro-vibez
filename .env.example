# Preferred backend once the self-hosted IZAKHONO Core server is online.
# When all three values are present, ALLEGRO VIBEZ automatically uses IZAKHONO Core.
VITE_IZAKHONO_CORE_URL=https://api.example.co.za
VITE_IZAKHONO_PROJECT=allegro_vibez
VITE_IZAKHONO_PUBLIC_KEY=ik_pub_REPLACE_ME

# Current production fallback during the migration window.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
