# ALLEGRO VIBEZ now targets IZAKHONO Core as its runtime backend.
# The public project key is browser-safe. Never place an ik_sec_* key here.
#
# Zero-Cost Host Mode on the host computer:
#   VITE_IZAKHONO_CORE_URL=http://127.0.0.1:8787
#
# A public Netlify build must use a Core URL that visitors can reach over the
# internet (for example an HTTPS endpoint routed to the same IZAKHONO host).
VITE_IZAKHONO_CORE_URL=http://127.0.0.1:8787
VITE_IZAKHONO_PROJECT=allegro_vibez
VITE_IZAKHONO_PUBLIC_KEY=ik_pub_REPLACE_ME
