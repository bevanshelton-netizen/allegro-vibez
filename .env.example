# Preferred self-hosted backend. When all three values are supplied, the app
# uses IZAKHONO Core automatically.
VITE_IZAKHONO_CORE_URL=https://api.izakhono.africa
VITE_IZAKHONO_PROJECT=allegro_vibez
VITE_IZAKHONO_PUBLIC_KEY=ik_pub_REPLACE_ME

# Optional temporary/failover backend overrides. The production source already
# contains the browser-safe ALLEGRO Supabase URL + publishable key as defaults,
# so Netlify does not require a manual environment edit to launch authentication.
VITE_SUPABASE_URL=https://zoolsumifdtanycjryje.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Never place an IZAKHONO ik_sec_* key, Supabase service-role key or PayFast
# merchant secret in VITE_* browser variables.
